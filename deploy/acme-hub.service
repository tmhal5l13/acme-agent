[Unit]
Description=acme-agent hub - centralized ACME renewal authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/acme-hub --config /etc/acme-hub/config.yaml
Restart=on-failure
RestartSec=5s

# Without this, "systemctl reload acme-hub" has nothing to do and fails
# outright - a plain Type=simple unit has no reload behavior by default.
# $MAINPID is systemd's own specifier for this unit's running process;
# see "Config hot-reload" above for what a SIGHUP actually does.
ExecReload=/bin/kill -HUP $MAINPID

# Identity: a fresh, unique UID/GID allocated by systemd for this service
# alone (never reused across restarts or other services), no shell, no
# home directory to manage manually. The hub never execs anything (unlike
# the spoke's reload hook, which needs a stable, nameable user for its
# sudoers rule - see acme-spoke.service), so it has no reason to need a
# real system user.
DynamicUser=yes
StateDirectory=acme-hub
StateDirectoryMode=0750

# Secrets referenced via ${VAR} in config.yaml (status_token, and any
# other startup-only field that needs one - spoke bearer tokens and DNS
# provider credentials live in the hub's own database instead, see
# ARCHITECTURE.md "Database-backed desired state") live in acme-hub.env,
# kept out of source control. acme-hub itself reads this file directly -
# not just via EnvironmentFile= below - every time it (re)loads
# config.yaml, including on every SIGHUP reload (see ARCHITECTURE.md
# "Config hot-reload"): a process's own environment is fixed at exec
# time, so a variable added to this file after startup would never
# become visible through EnvironmentFile= alone without a restart. That
# direct read needs real read access to the file, which
# DynamicUser's freshly-allocated, otherwise-unprivileged UID doesn't
# have on its own - hence acme-hub-secrets below: a stable group (unlike
# the UID, which changes every start) that install-hub.sh creates and
# grants read access to acme-hub.env (mode 0640, group acme-hub-secrets).
SupplementaryGroups=acme-hub-secrets

# Also kept as a fallback: if the SupplementaryGroups grant above is ever
# missing or misconfigured, the hub still starts (systemd reads this file
# as root, before dropping to DynamicUser, so this path doesn't depend on
# the grant at all) - reload would just degrade to not seeing variables
# added to the file since startup, the same limitation that existed
# before the direct-read mechanism above, not a hard failure.
EnvironmentFile=/etc/acme-hub/acme-hub.env

# Hardening. NoNewPrivileges/ProtectSystem/ProtectHome/PrivateTmp/
# MemoryDenyWriteExecute were verified directly against this project's
# compiled binary (pure Go, no cgo) via a rootless `systemd-run --user`
# transient unit during development - it started, bound its port, and
# served real requests under all of them. The remaining directives are
# standard systemd.exec(5) hardening for a network-facing daemon that
# touches no kernel interfaces, no namespaces, and no real-time
# scheduling; they could not be verified the same way (dropping some
# capabilities-gated restrictions requires CAP_SETPCAP, which an
# unprivileged user session doesn't have - the failure is a limitation of
# rootless testing, not a sign of incompatibility), but they apply
# correctly under the real root-managed system unit this file describes.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
